# Apptainer definition for the analysis environment.
#
# scripts/truba_build_container.sh builds the same environment on TRUBA, but it
# starts from /arf/sw/containers/miniconda3/miniconda3-container.sif — a path
# that exists only on that cluster, so nobody else can run it. This file starts
# from a public image instead and is the one to use anywhere else.
#
#   apptainer build mitofeasible.sif env/mitofeasible.def
#   apptainer exec --bind /path/to/data mitofeasible.sif python3 scripts/...
#
# Versions come from env/versions.lock, the set the published results were
# produced with. Drop the --file line to take current releases instead; expect
# the numbers to move if STAR or samtools do.
#
# Architecture: x86_64. The lock pins bioconda builds of STAR and samtools that
# exist for linux-64 only, so this does not build on an ARM host even though the
# base image does.
#
# The base is pinned by digest, not by the 1.5.8 tag. A tag is a mutable pointer
# -- it can be moved or removed by its publisher -- and a definition file whose
# starting point can change is not a record of anything. The digest below is the
# multi-architecture index that 1.5.8 resolved to on 2026-09-16; its linux/amd64
# member, the one that gets used here, is
# sha256:69197a394b85ad1e7ce2398cdaffa75c12e5cd9dcc8529651342818e7b239e59.
#
# To move to a newer base deliberately, resolve the tag again:
#   docker buildx imagetools inspect mambaorg/micromamba:<tag>
# and replace the digest, rather than dropping back to a tag.

Bootstrap: docker
From: mambaorg/micromamba@sha256:475730daef12ff9c0733e70092aeeefdf4c373a584c952dac3f7bdb739601990

%files
    env/versions.lock /opt/versions.lock

%post
    set -eux
    # `create`, not `install`: install requires the prefix to exist already, and
    # /opt/mitofeasible does not exist in the base image.
    micromamba create -y -p /opt/mitofeasible -c conda-forge -c bioconda \
        --file /opt/versions.lock
    micromamba clean -ya
    # The lock carries transitive packages too, so a failure here is a genuine
    # conflict rather than a missing dependency.
    /opt/mitofeasible/bin/python -c "import pandas, numpy, scipy, pysam, yaml, matplotlib"
    /opt/mitofeasible/bin/STAR --version
    /opt/mitofeasible/bin/samtools --version | head -1

%environment
    export PATH=/opt/mitofeasible/bin:$PATH

%runscript
    exec /opt/mitofeasible/bin/python "$@"

%test
    # Runs at build time: the pipeline's own selftests need no data, so a built
    # image can be checked before it is trusted with a run.
    /opt/mitofeasible/bin/python -c "import scipy.stats as s; print(s.binom.isf(0.01, 1000, 1e-3))"

%labels
    Name mitofeasible
    Description Position-level feasibility of mtDNA variant calling from bulk RNA-seq
    Repository https://github.com/dralperenuysal/mitofeasible
